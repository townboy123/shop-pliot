# ============================================
# ShopPilot 环境变量样例
# 复制为 .env 后按需修改；.env 不应提交
# ============================================

# ---------- 运行环境 ----------
NODE_ENV=development

# ---------- LLM 供应商 ----------
# 取值：openai | fake
# fake 用于本地开发与测试，不消耗 API 额度
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# OpenAI 兼容端点（自定义代理 / vLLM / Ollama / OneAPI 等），仅 LLM_PROVIDER=openai 时生效；
# 留空或不配置 = 走 OpenAI 官方 API
# LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 服务 ----------
PORT=3000
# 硬预算：单请求超时（毫秒），超时以 503 中断
# deepseek-flash 是推理模型（先输出 reasoning_content 再回答），单次 LLM 调用较慢，
# 工作流一轮要串多次 LLM 调用 → 硬/软预算都要放大（软预算 < 硬预算）
REQUEST_TIMEOUT_MS=120000
LOG_LEVEL=info

# ---------- 持久化 ----------
# 业务 DB（含 tenants/users/products/orders/return_requests/policies/memories）
DB_PATH=./data/shoppilot.db
# Checkpoint DB 必须与业务 DB 分文件（§6）
CHECKPOINT_PATH=./data/checkpoints.db

# ---------- 软预算（超出后优雅降级到 composeResponse） ----------
MAX_STEPS=12
MAX_TOOL_CALLS=8
# 推理模型的 reasoning tokens 也计入 usage，给足余量
MAX_TOKENS=60000
MAX_WALL_CLOCK_MS=110000

# ---------- 澄清防打转 ----------
MAX_CLARIFY_ROUNDS=3

# ---------- 限流（内存滑窗） ----------
TOOL_CALLS_PER_MINUTE=30
CHATS_PER_MINUTE_PER_USER=10

# ---------- 上下文管理 ----------
KEEP_SYSTEM_MESSAGES=true
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_TOKENS=4000
COMPACTION_STRATEGY=drop
KEEP_RECENT_MESSAGES=4

# ---------- 长期记忆 ----------
MEMORY_ENABLED=true
MEMORY_MAX_TOKENS=800
MEMORY_MAX_PER_CONTEXT=8
MEMORY_MIN_CONFIDENCE_TO_WRITE=0.6
MEMORY_TTL_PREFERENCE_MS=15552000000
MEMORY_TTL_FACT_MS=7776000000
MEMORY_TTL_EPISODIC_MS=31536000000
MEMORY_TTL_PROCEDURAL_MS=15552000000
MEMORY_EXTRACTOR=rule
MEMORY_ALLOW_KINDS=preference,fact,episodic,procedural

# ---------- 工具执行策略 ----------
TOOL_DEFAULT_TIMEOUT_MS=15000
TOOL_MAX_ATTEMPTS=3
TOOL_WRITE_MAX_ATTEMPTS=1
TOOL_BASE_DELAY_MS=200
TOOL_MAX_DELAY_MS=2000
TOOL_JITTER=true

# 熔断
TOOL_CB_ENABLED=true
TOOL_CB_FAILURE_THRESHOLD=5
TOOL_CB_OPEN_MS=30000
TOOL_CB_HALF_OPEN_MAX=2

# 去重
TOOL_DEDUPE_ENABLED=true
TOOL_DEDUPE_CACHE_TTL_MS=300000
TOOL_DEDUPE_SINGLE_FLIGHT=true

# ---------- Agent 范式 ----------
# 取值：workflow | react | plan_solve | hybrid
AGENT_MODE=workflow

# ReAct
REACT_MAX_ITERATIONS=6
REACT_MAX_SAME_TOOL_CALLS=2
REACT_ALLOWED_TOOLS=searchProducts,getOrder,getLogistics,checkReturnEligibility
REACT_FINALIZE_ON_LIMIT=true

# Plan-and-Solve
PLAN_MAX_STEPS=8
PLAN_MAX_REPLANS=2
PLAN_MAX_TOOL_ITERATIONS=12
PLAN_ALLOWED_TOOLS=searchProducts,getOrder,getLogistics,checkReturnEligibility

# ---------- MCP ----------
MCP_ENABLED=false
# deny：未命中任何 toolAllowPrefixes 的工具不注册
# sandbox：注册但从严元信息 + 超时 + 每会话调用上限
MCP_DEFAULT_POLICY=deny
MCP_REQUEST_TIMEOUT_MS=30000

# 单个 MCP server 的配置以 JSON 数组传入（也可改用配置文件）
# 示例：一个 stdio 的本地物流查询 server
# MCP_SERVERS_JSON=[{"id":"logistics-remote","enabled":true,"transport":{"kind":"stdio","command":"node","args":["./scripts/mcp-logistics.js"]},"toolAllowPrefixes":["get_logistics"],"toolCallTimeoutMs":20000,"maxCallsPerSession":3}]

# ---------- 检索（政策 + 长期记忆） ----------
# keyword：SQLite 关键词（零依赖）；lancedb：本地向量检索（需 models/Xenova/bge-small-zh-v1.5）
RETRIEVER=lancedb
LANCEDB_URI=./data/lancedb
# 本地嵌入模型（相对 models 目录；默认 Xenova/bge-small-zh-v1.5，384 维）
# MODELS_PATH=./models
# EMBED_MODEL=Xenova/bge-small-zh-v1.5
